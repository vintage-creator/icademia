# Nomba server-side credentials.
# Use sandbox credentials with https://sandbox.nomba.com and live credentials
# with https://api.nomba.com. Never expose these values with a VITE_ prefix.
NOMBA_ACCOUNT_ID=
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_WEBHOOK_SECRET=
NOMBA_BASE_URL=https://sandbox.nomba.com
NOMBA_CALLBACK_URL=https://icademia.app/payment-callback
NOMBA_WEBHOOK_URL=https://icademia.app/api/nomba/webhook

# Application and infrastructure
APP_URL=https://icademia.app
DATABASE_URL=
GEMINI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=iCademia <hello@icademia.app>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Restricted platform-operations dashboard (/super-admin).
# Use a long random value and keep it server-side.
SUPER_ADMIN_KEY=
